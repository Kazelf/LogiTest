# App
NODE_ENV=development

# Web
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# API
API_PORT=8000

# Database
DATABASE_URL=postgresql://logitest:logitest@database:5432/logitest_ai

# Elasticsearch demo source
ELASTICSEARCH_URL=http://elasticsearch:9200
DEMO_LOG_INDEX=logitest-demo-logs

# ShopLite log bridge
SHOPLITE_LOG_PATH=../shoplite/server/logs/request-logs.jsonl

# Test execution target
STAGING_API_BASE_URL=http://localhost:4000

# Gemini behavior explanation
GEMINI_API_KEY=your_gemini_key_here
AI_PROVIDER=gemini
GEMINI_MODEL=gemini-1.5-flash
AI_FALLBACK_RULE_BASED=true
